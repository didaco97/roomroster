{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roomroster-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "workers_dev": true,
  "routes": [
    { "pattern": "roomroster.me", "custom_domain": true },
    { "pattern": "www.roomroster.me", "custom_domain": true }
  ],
  // Keep automatic sending off until bounded capacity and delivery checks pass.
  "triggers": { "crons": [] },
  "observability": { "enabled": true },
  "vars": {
    "APP_URL": "https://roomroster.me",
    "SMTP_USER": "roomroster07@gmail.com",
    "ORGANIZER_EMAIL": "roomroster07@gmail.com",
    "ADMIN_EMAIL": "roomroster07@gmail.com",
    "GEMINI_MODEL": "gemini-2.5-flash",
  },
}
