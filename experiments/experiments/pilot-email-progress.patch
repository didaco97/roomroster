+  state.queries=0;state.sent=0;
+  const start=performance.now(); await digest();
+  console.log(JSON.stringify({recipients:size,sqlSubrequests:state.queries,smtpAttempts:state.sent,isolatedDbAndAppWallMs:Math.round(performance.now()-start)}));
