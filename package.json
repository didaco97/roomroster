{
  "name": "roomroster",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx server/migrate.ts",
    "dev:full": "npx netlify-cli@latest dev",
    "preview": "vite preview --host 0.0.0.0",
    "workers:dev": "npm run build && wrangler dev",
    "workers:check": "npm run build && wrangler deploy --dry-run",
    "workers:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.0",
    "@neondatabase/serverless": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.5.0",
    "radix-ui": "^1.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "tailwind-merge": "^3.0.0",
    "tw-animate-css": "^1.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@electric-sql/pglite": "^0.5.16",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1"
  }
}
