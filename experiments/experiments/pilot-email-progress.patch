+import {rankProfiles,blankProfile,roles} from '../src/domain';
+const fixtures=Array.from({length:50},(_,i)=>({...blankProfile(),id:`fixture-${i}`,event:'fixture-only',name:'N'.repeat(70),startup:'S'.repeat(100),bio:'website agriculture '.repeat(15).slice(0,240),location:'P'.repeat(100),offers:[...roles],needText:'website agriculture '.repeat(40).slice(0,800),offerText:'website frontend developer '.repeat(40).slice(0,800)}));
+const serialized=JSON.stringify(fixtures);
+export default {
+ async fetch(req:Request,env:any){
+  const u=new URL(req.url);
+  if(req.method==='GET')return Response.json({fixtureOnly:true,people:50,bytes:serialized.length,smtp:false,database:false});
+  // Fixed-size, fixture-only UI-triggered canary; deleted after measurement.
+  if(req.method!=='POST'||u.pathname!=='/run-fixture-327613')return new Response('Not found',{status:404});
+  const b:any=await req.json();if(!['round1','round2','round3'].includes(b.round))return new Response('Bad fixture round',{status:400});
+  const created=Date.now();const messages=Array.from({length:50},(_,i)=>({body:{round:b.round,sequence:i,created,fixture:true}}));
+  await env.FIXTURE_QUEUE.sendBatch(messages);return Response.json({queued:50,round:b.round,created});
+ },
+ async queue(batch:any){
+  if(batch.messages.length!==1)throw Error('Canary requires batch1');
+  for(const message of batch.messages){
+   const b=message.body;if(b.fixture!==true||!Number.isInteger(b.sequence)||b.sequence<0||b.sequence>49||!['round1','round2','round3'].includes(b.round)){message.ack();continue;}
+   const roster=JSON.parse(serialized);const person=roster[b.sequence];
+   const matches=rankProfiles(person.needText,roster,person.id).slice(0,3);
+   console.log(JSON.stringify({fixtureCanary:true,round:b.round,sequence:b.sequence,ageMs:Date.now()-b.created,candidates:49,matches:matches.length,bytes:serialized.length,smtp:false,database:false}));
+   message.ack();
+  }
+ }
+};
