+import {rankProfiles,blankProfile,roles} from '../src/domain';
+import {mergeTop} from '../server/digest-bounded';
+const candidates=Array.from({length:16},(_,i)=>({...blankProfile(),id:String(i),name:'N'.repeat(70),startup:'S'.repeat(100),bio:'website agriculture sales '.repeat(12).slice(0,240),location:'P'.repeat(100),offers:[...roles],offerText:'website frontend developer '.repeat(40).slice(0,800)}));
+const query=[...roles,'website agriculture '.repeat(45).slice(0,800)].join(' ');
+const serialized=JSON.stringify(candidates);
+const durations:number[]=[];
+for(let i=0;i<1100;i++) {
+ const before=process.cpuUsage();
+ const input=JSON.parse(serialized);
+ const ranked=rankProfiles(query,input).map(m=>({id:m.profile.id,name:m.profile.name,reason:m.reason,score:m.score}));
+ const result=JSON.stringify(mergeTop([],ranked));
+ const cpu=process.cpuUsage(before); if(i>=100)durations.push((cpu.user+cpu.system)/1000);
+ if(result.length===0)throw Error('missing result');
+}
+durations.sort((a,b)=>a-b);
+console.log(JSON.stringify({scope:'local Node CPU only: candidate JSON decode, rank, top-3 merge and JSON encode',candidatePage:16,inputBytes:serialized.length,samples:durations.length,p50ms:durations[500],p95ms:durations[950],maxms:durations[999],notProductionWorkersCpuEvidence:true}));
