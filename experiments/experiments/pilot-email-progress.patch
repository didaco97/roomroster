+// Isolated prototype. Not imported by the production Worker.
+import { randomUUID } from 'node:crypto';
+import { db } from './db';
+import { publicProfile, hash } from './security';
+import { rankProfiles } from '../src/domain';
+
+export const CANDIDATE_PAGE = 16;
+const ZERO = '00000000-0000-0000-0000-000000000000';
+type Suggestion = {id:string;name:string;reason:string;score:number};
+type Job = {profile:string;event:string;email:string;need:string;fingerprint:string;until:string;after:string;top:Suggestion[];scanned:number};
+export function needs(data:any) {
+  return [...(data.needs || []),data.needText || ''].join(' ').trim();
+}
+function fingerprint(p:any) {
+  return hash(JSON.stringify([p.email, p.verified, p.data.alerts, needs(p.data), !!p.data.aiConsent]));
+}
+// Associative top-k reduction: no first-page cutoff, and bounded retained state.
+export function mergeTop(previous:Suggestion[],next:Suggestion[]) {
+  const unique=new Map<string,Suggestion>();
+  for(const item of [...previous,...next]) unique.set(item.id,item);
+  return [...unique.values()].sort((a,b)=>b.score-a.score || a.id.localeCompare(b.id)).slice(0,3);
+}
+export async function boundedDigest() {
+  // Chunking a global model request changes rankings/costs. Never do that silently.
+  if(process.env.GEMINI_API_KEY) return {state:'blocked-ai-mode'};
+  const sql=db(); const lease=randomUUID();
+  await sql`INSERT INTO digest_work(id) VALUES(1) ON CONFLICT DO NOTHING`;
+  const claims=await sql`UPDATE digest_work SET lease=${lease}::uuid,lease_until=now()+interval '5 minutes' WHERE id=1 AND (lease_until IS NULL OR lease_until<now()) RETURNING *`;
+  if(!claims.length) return {state:'busy'};
+  const state=claims[0]; let job:Job|null=state.job;
+  const save=async (job:Job|null,event:string=state.last_event,profile:string=state.last_profile)=>
+    await sql`UPDATE digest_work SET job=${JSON.stringify(job)}::jsonb,last_event=${event},last_profile=${profile}::uuid,lease=NULL,lease_until=NULL WHERE id=1 AND lease=${lease}::uuid RETURNING id`;
+  if(!job) {
+    const rows=await sql`SELECT p.* FROM profiles p JOIN events e ON e.slug=p.event WHERE (p.event,p.id)>(${state.last_event},${state.last_profile}::uuid) AND p.verified AND COALESCE((p.data->>'alerts')::boolean,false) AND (jsonb_array_length(COALESCE(p.data->'needs','[]'::jsonb))>0 OR btrim(COALESCE(p.data->>'needText',''))<>'') AND NOT COALESCE((e.data->>'closed')::boolean,false) AND NOT COALESCE((e.data->>'pending')::boolean,false) AND NOT EXISTS(SELECT 1 FROM mail_queue q WHERE q.email=p.email AND q.event=p.event AND q.kind='match' AND q.state IN ('pending','sending')) ORDER BY p.event,p.id LIMIT 1`;
+    if(!rows.length) {await save(null,'',ZERO);return {state:'cycle-complete'};}
+    const p=rows[0];
+    job={profile:p.id,event:p.event,email:p.email,need:needs(p.data),fingerprint:fingerprint(p),until:new Date().toISOString(),after:ZERO,top:[],scanned:0};
+  }
+  const people=await sql`SELECT p.*,e.data AS event_data FROM profiles p JOIN events e ON e.slug=p.event WHERE p.id=${job.profile}::uuid`;
+  const p=people[0];
+  if(!p || fingerprint(p)!==job.fingerprint || p.event_data.closed || p.event_data.pending) {
+    await save(null,job.event,job.profile);return {state:'recipient-changed'};
+  }
+  const page=await sql`SELECT p.id,p.event,p.joined,p.data-'photo'-'website'-'linkedin'-'email'-'phone' AS data FROM profiles p WHERE p.event=${job.event} AND p.id>${job.after}::uuid AND p.id<>${job.profile}::uuid AND p.joined<=${job.until}::timestamptz AND NOT EXISTS(SELECT 1 FROM match_updates m WHERE m.profile=${job.profile}::uuid AND m.candidate=p.id) AND NOT EXISTS(SELECT 1 FROM connections c WHERE c.event=${job.event} AND ((c.sender=${job.profile}::uuid AND c.recipient=p.id) OR (c.recipient=${job.profile}::uuid AND c.sender=p.id))) ORDER BY p.id LIMIT ${CANDIDATE_PAGE+1}`;
+  const batch=page.slice(0,CANDIDATE_PAGE);
+  const ranked=rankProfiles(job.need,batch.map(publicProfile),job.profile).map(m=>({id:m.profile.id,name:m.profile.name,reason:m.reason,score:m.score}));
+  job.top=mergeTop(job.top,ranked);job.scanned+=batch.length;
+  if(page.length>CANDIDATE_PAGE) {
+    job.after=batch[batch.length-1].id;
+    const saved=await save(job);return {state:saved.length?'scanning':'lost-lease',scanned:job.scanned};
+  }
+  if(!job.top.length) {await save(null,job.event,job.profile);return {state:'no-match',scanned:job.scanned};}
+  const cursor=(await sql`SELECT seen FROM digest_cursor WHERE profile=${job.profile}::uuid`)[0]?.seen || p.joined;
+  const count=Number((await sql`SELECT count(*) AS count FROM profiles WHERE event=${job.event} AND id<>${job.profile}::uuid AND joined>${cursor}::timestamptz AND joined<=${job.until}::timestamptz`)[0].count);
+  const data={profile:job.profile,count,until:job.until,matches:job.top.map(({score,...m})=>m)};
+  const dedupe=`match:${job.profile}:${hash(job.top.map(m=>m.id).sort().join(','))}`;
+  // Atomic completion + queue insert. An expired/stolen lease cannot queue mail.
+  const completed=await sql`WITH done AS (UPDATE digest_work SET job=NULL,last_event=${job.event},last_profile=${job.profile}::uuid,lease=NULL,lease_until=NULL WHERE id=1 AND lease=${lease}::uuid AND lease_until>=now() RETURNING id) INSERT INTO mail_queue(id,email,event,kind,data,dedupe) SELECT ${randomUUID()}::uuid,${job.email},${job.event},'match',${JSON.stringify(data)}::jsonb,${dedupe} FROM done ON CONFLICT(dedupe) DO NOTHING RETURNING id`;
+  return {state:completed.length?'queued':'deduplicated-or-lost-lease',scanned:job.scanned};
+}
