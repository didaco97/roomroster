+// Isolated Free Queues feasibility prototype, not imported in production.
+import {randomUUID} from 'node:crypto';
+import {db} from './db';
+import {hash,publicProfile} from './security';
+import {rankProfiles} from '../src/domain';
+import {needs} from './digest-bounded';
+export type PilotJob={run:string;profile:string};
+export async function snapshot(event:string,slot:string) {
+ if(process.env.GEMINI_API_KEY) return {state:'blocked-ai-mode',jobs:[] as PilotJob[]};
+ const sql=db();
+ // Single SQL statement establishes one immutable roster version for the slot.
+ // The stripped JSON has no photos or contact/link fields.
+ const rows=await sql`WITH opened AS (SELECT slug FROM events WHERE slug=${event} AND NOT COALESCE((data->>'closed')::boolean,false) AND NOT COALESCE((data->>'pending')::boolean,false)), run AS (INSERT INTO pilot_digest_runs(id,event,slot,roster) SELECT ${randomUUID()}::uuid,slug,${slot},COALESCE((SELECT jsonb_agg(jsonb_build_object('id',p.id,'event',p.event,'joined',p.joined,'verified',p.verified,'data',p.data-'photo'-'website'-'linkedin'-'email'-'phone') ORDER BY p.id) FROM profiles p WHERE p.event=opened.slug),'[]'::jsonb) FROM opened ON CONFLICT(event,slot) DO UPDATE SET slot=EXCLUDED.slot RETURNING *) INSERT INTO pilot_digest_jobs(run,profile) SELECT run.id,(p->>'id')::uuid FROM run,jsonb_array_elements(run.roster) AS p WHERE (p->>'verified')::boolean AND COALESCE((p->'data'->>'alerts')::boolean,false) AND (jsonb_array_length(COALESCE(p->'data'->'needs','[]'::jsonb))>0 OR btrim(COALESCE(p->'data'->>'needText',''))<>'') ON CONFLICT DO NOTHING`;
+ // Durable outbox IDs: safe to republish after a crash. Consumer is idempotent.
+ const jobs=await sql`SELECT j.run,j.profile FROM pilot_digest_jobs j JOIN pilot_digest_runs r ON r.id=j.run WHERE r.event=${event} AND r.slot=${slot} AND j.state='pending' ORDER BY j.profile`;
+ return {state:'snapshotted',jobs:jobs as PilotJob[]};
+}
+export async function matchSnapshot(job:PilotJob){
+ if(process.env.GEMINI_API_KEY)return {state:'blocked-ai-mode'};
+ const sql=db();
+ const rows=await sql`SELECT r.roster,r.event,r.created,p.email,p.data,p.verified,e.data AS event_data FROM pilot_digest_jobs j JOIN pilot_digest_runs r ON r.id=j.run JOIN profiles p ON p.id=j.profile JOIN events e ON e.slug=r.event WHERE j.run=${job.run}::uuid AND j.profile=${job.profile}::uuid AND j.state='pending'`;
+ if(!rows.length)return {state:'already-completed-or-removed'};
+ const r=rows[0],self=r.roster.find((p:any)=>p.id===job.profile);
+ if(!self || !r.verified || !r.data.alerts || r.event_data.closed || r.event_data.pending || needs(r.data)!==needs(self.data)){
+  await sql`UPDATE pilot_digest_jobs SET state='cancelled' WHERE run=${job.run}::uuid AND profile=${job.profile}::uuid AND state='pending'`;
+  return {state:'recipient-changed'};
+ }
+ const excluded=await sql`SELECT candidate AS id FROM match_updates WHERE profile=${job.profile}::uuid UNION SELECT CASE WHEN sender=${job.profile}::uuid THEN recipient ELSE sender END AS id FROM connections WHERE event=${r.event} AND (sender=${job.profile}::uuid OR recipient=${job.profile}::uuid)`;
+ const exclude=new Set(excluded.map((p:any)=>p.id));exclude.add(job.profile);
+ const candidates=r.roster.filter((p:any)=>!exclude.has(p.id));
+ const matches=rankProfiles(needs(self.data),candidates.map(publicProfile),job.profile).sort((a,b)=>b.score-a.score||a.profile.id.localeCompare(b.profile.id)).slice(0,3);
+ const mailId=randomUUID();const dedupe=`match:${job.profile}:${hash(matches.map(m=>m.profile.id).sort().join(','))}`;
+ // Revalidate the recipient within the completion statement; no email is sent here.
+ // SKIP LOCKED is not needed: row update atomically elects one completion winner.
+ const data={profile:job.profile,count:r.roster.filter((p:any)=>p.id!==job.profile).length,until:new Date(r.created).toISOString(),matches:matches.map(m=>({id:m.profile.id,name:m.profile.name,reason:m.reason}))};
+ const completed=await sql`WITH done AS (UPDATE pilot_digest_jobs SET state=${matches.length?'matched':'no-match'},mail=${matches.length?mailId:null}::uuid WHERE run=${job.run}::uuid AND profile=${job.profile}::uuid AND state='pending' AND EXISTS(SELECT 1 FROM profiles p JOIN events e ON e.slug=p.event WHERE p.id=${job.profile}::uuid AND p.event=${r.event} AND p.verified AND COALESCE((p.data->>'alerts')::boolean,false) AND p.data=${JSON.stringify(r.data)}::jsonb AND NOT COALESCE((e.data->>'closed')::boolean,false) AND NOT COALESCE((e.data->>'pending')::boolean,false)) RETURNING profile) INSERT INTO mail_queue(id,email,event,kind,data,dedupe) SELECT ${mailId}::uuid,${r.email},${r.event},'match',${JSON.stringify(data)}::jsonb,${dedupe} FROM done WHERE ${matches.length}>0 ON CONFLICT(dedupe) DO NOTHING RETURNING id`;
+ return {state:completed.length?'queued':'no-match-or-deduplicated',candidates:candidates.length,ranked:matches.map(m=>m.profile.id)};
+}
